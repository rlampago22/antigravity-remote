# Token fornecido pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_do_bot_aqui

# Seu ID de usuário no Telegram (opcional no início - o bot informa seu ID ao dar /start)
# Exemplo: ALLOWED_USER_ID=123456789
ALLOWED_USER_ID=

# Modo de exibição: compact (apenas ações e respostas finais) ou verbose (com pensamentos do agente)
LOG_MODE=compact

# Modelo padrão para novas tarefas (flash, pro, flash_lite)
DEFAULT_MODEL=flash
